[Unit]
Description=Move nix dir to usrlocal
ConditionPathExists=/etc/.nix-mount-temp/nix
After=var.mount etc.mount
BindsTo=var.mount etc.mount

[Service]
Type=oneshot
ExecStart=/bin/bash -c "mv /etc/.nix-mount-temp/nix /var/usrlocal && rmdir /etc/.nix-mount-temp"
ExecStartPost=/usr/bin/systemctl disable nix-dir-move.service

[Install]
WantedBy=multi-user.target
